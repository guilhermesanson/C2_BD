erDiagram
    FORNECEDOR ||--o{ PRODUTO : fornece

    FORNECEDOR {
        NUMBER id_fornecedor PK "GENERATED BY DEFAULT AS IDENTITY; obrigatório"
        VARCHAR2(100) nome "Obrigatório"
        VARCHAR2(18) cnpj UK "Obrigatório; único"
        VARCHAR2(20) telefone "Opcional"
        VARCHAR2(100) email "Opcional"
        VARCHAR2(100) logradouro "Obrigatório"
        VARCHAR2(10) numero "Obrigatório"
        VARCHAR2(50) complemento "Opcional"
        VARCHAR2(60) bairro "Obrigatório"
        VARCHAR2(60) cidade "Obrigatório"
        CHAR(2) estado "Obrigatório"
        VARCHAR2(9) cep "Obrigatório"
    }

    PRODUTO {
        NUMBER id_produto PK "GENERATED BY DEFAULT AS IDENTITY; obrigatório"
        VARCHAR2(100) nome "Obrigatório"
        VARCHAR2(200) descricao "Opcional"
        NUMBER preco "NUMBER(10,2); Obrigatório; CHECK >= 0"
        NUMBER(10) quantidade "Obrigatório; CHECK >= 0"
        NUMBER id_fornecedor FK "Obrigatório; referencia FORNECEDOR"
    }

%% PK: pk_fornecedor e pk_produto
%% UK: uq_fornecedor_cnpj UNIQUE (cnpj)
%% CHECK: ck_produto_preco CHECK (preco >= 0)
%% CHECK: ck_produto_quantidade CHECK (quantidade >= 0)
%% FK: fk_produto_fornecedor referencia FORNECEDOR(id_fornecedor)
%% Ordem de criação: FORNECEDOR, depois PRODUTO.
